{
  "name": "sitekey",
  "version": "0.1.0",
  "private": false,
  "description": "Local-first password manager that knows which account is which.",
  "keywords": [
    "password-manager",
    "chrome-extension",
    "mv3",
    "local-first",
    "encryption",
    "pbkdf2",
    "aes-gcm"
  ],
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/imlikun/sitekey#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imlikun/sitekey.git"
  },
  "bugs": {
    "url": "https://github.com/imlikun/sitekey/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "icons": "python3 scripts/make_icons.py",
    "test": "node tests/csv.test.mjs && node tests/merge.test.mjs && node tests/sync.test.mjs && node tests/import.test.mjs && node tests/detector.test.mjs",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "verify": "npm run typecheck && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.0"
  }
}
